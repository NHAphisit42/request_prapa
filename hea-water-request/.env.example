# Entra ID (Azure AD) app registration — grant Sites.ReadWrite.All (application permission)
# and get admin consent. Client secret should be a real secret, not a certificate, unless you
# adapt msal-node config accordingly.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-app-registration-client-secret

# SharePoint site + list to write submissions into.
# Get SHAREPOINT_SITE_ID via:
#   GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-path}
# Get SHAREPOINT_LIST_ID via:
#   GET https://graph.microsoft.com/v1.0/sites/{site-id}/lists
SHAREPOINT_SITE_ID=your-tenant.sharepoint.com,site-guid,web-guid
SHAREPOINT_LIST_ID=your-water-request-list-guid

# "AdminRoles" SharePoint list — one row per staff member allowed into /admin.
# Required column: LineUserId (single line of text). Title (default column) can hold
# the staff member's name for readability when editing the list by hand.
# Get its GUID the same way as SHAREPOINT_LIST_ID above.
SHAREPOINT_ADMIN_LIST_ID=your-admin-roles-list-guid

# LINE LIFF app ID (client-side, safe to expose) — from the LINE Developers console.
NEXT_PUBLIC_LIFF_ID=your-liff-id
